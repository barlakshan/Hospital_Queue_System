# Copy to .env and fill in. Never commit .env.

# ── Application ───────────────────────────────────────────────────────────
FLASK_APP=wsgi.py
# development | production   (FLASK_ENV is still read as a fallback)
APP_ENV=development
# Required in production: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Public HTTPS origin, e.g. https://queue.example.com. Used in QR codes and
# as the only origin allowed to open Socket.IO connections.
BASE_URL=http://localhost:5000
# Time zone for the queue day and every time shown to staff.
APP_TIMEZONE=Asia/Colombo
# Reverse proxies in front of the app whose X-Forwarded-For/Proto headers are
# trusted. Production defaults to 1 (nginx). Use 0 when not behind a proxy.
# TRUSTED_PROXY_COUNT=1
# Production marks session cookies Secure (HTTPS only). Set to false ONLY
# while testing over plain HTTP on the server's IP; remove once HTTPS is on.
# COOKIE_SECURE=false

# ── Database ──────────────────────────────────────────────────────────────
# Development: leave unset to use a local SQLite file (pbqms_dev.sqlite3).
# Production: REQUIRED (the app refuses to start without it), e.g.
#   DATABASE_URL=mysql+pymysql://pbqms_user:STRONG_PASSWORD@localhost/pbqms
# Docker compose: set DB_PASSWORD and DB_ROOT_PASSWORD instead.
# DATABASE_URL=
# DB_PASSWORD=
# DB_ROOT_PASSWORD=

# ── Public registration ───────────────────────────────────────────────────
# Patients may *request* priority; staff confirm it. Set to true only if
# self-declared priority should move patients up the queue immediately.
ALLOW_SELF_DECLARED_PRIORITY=false
MAX_TOKENS_PER_MOBILE_PER_DAY=3

# ── SMS ───────────────────────────────────────────────────────────────────
# mock | textlk | dialog | mobitel | twilio
SMS_PROVIDER=mock

# Text.lk. The sender ID must be registered to your Text.lk account,
# otherwise every message is rejected (shows as FAILED in sms_logs).
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=MELSTAHOSP

# Dialog Sri Lanka
DIALOG_USER=
DIALOG_PASS=
DIALOG_SENDER_ID=MELSTAHOSP

# Mobitel
MOBITEL_TOKEN=
MOBITEL_SENDER_ID=MELSTAHOSP

# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
